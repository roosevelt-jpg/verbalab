generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  owner
  admin
  member
}

enum ApiKeyEnvironment {
  live
  test
}

enum LanguageTier {
  vendor
  strategic_african
}

model Organization {
  id                   String   @id @default(cuid())
  clerkOrgId           String?  @unique @map("clerk_org_id")
  name                 String
  plan                 String   @default("free")
  characterQuota       Int      @default(50000) @map("character_quota")
  dataRegion           String?  @map("data_region")
  stripeCustomerId     String?  @unique @map("stripe_customer_id")
  stripeSubscriptionId String?  @unique @map("stripe_subscription_id")
  stripeConnectAccountId String? @unique @map("stripe_connect_account_id")
  stripeConnectChargesEnabled Boolean @default(false) @map("stripe_connect_charges_enabled")
  billingStatus        String   @default("active") @map("billing_status")
  webhookSigningSecret String?  @map("webhook_signing_secret")
  retentionDays        Int?     @map("retention_days")
  persistSourceText    Boolean  @default(true) @map("persist_source_text")
  allowVendorTraining  Boolean  @default(false) @map("allow_vendor_training")
  disabledAt           DateTime? @map("disabled_at")
  disabledReason       String?  @map("disabled_reason")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  memberships         Membership[]
  workspaces          Workspace[]
  apiKeys             ApiKey[]
  translationRequests TranslationRequest[]
  usageEvents         UsageEvent[]
  auditEvents         AuditEvent[]
  jobs                Job[]
  documents           Document[]
  glossaryTerms       GlossaryTerm[]
  tmEntries           TranslationMemoryEntry[]
  translationReviews  TranslationReview[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks     KnowledgeChunk[]
  slackInstallations  SlackInstallation[]
  workflows           Workflow[]
  prompts             Prompt[]
  marketplaceListings MarketplaceListing[] @relation("MarketplacePublisher")
  marketplaceInstalls MarketplaceInstall[] @relation("MarketplaceInstaller")
  marketplaceSalesAsPublisher MarketplaceSale[] @relation("MarketplaceSalePublisher")
  marketplaceSalesAsBuyer     MarketplaceSale[] @relation("MarketplaceSaleBuyer")
  datasetAssets               DatasetAsset[]
  verticalGlossaryInstalls    VerticalGlossaryInstall[]
  fineTuneJobs                FineTuneJob[]
  voiceClones                 VoiceClone[]
  speechVocabularyTerms       SpeechVocabularyTerm[]
  speakerProfiles             SpeakerProfile[]
  speakerEvents               SpeakerEvent[]
  wakeKeywords                WakeKeyword[]
  callRecords                 CallRecord[]
  voiceStudioProjects         VoiceStudioProject[]
  voiceStudioLexemes          VoiceStudioLexeme[]
  voiceStudioProfiles         VoiceStudioProfile[]
  voiceListingsPublished      VoiceListing[] @relation("VoiceListingPublisher")
  voiceListingInstalls        VoiceListingInstall[] @relation("VoiceListingInstaller")
  voiceListingReviews         VoiceListingReview[]
  voiceListingSalesAsPublisher VoiceListingSale[] @relation("VoiceListingSalePublisher")
  voiceListingSalesAsBuyer     VoiceListingSale[] @relation("VoiceListingSaleBuyer")
  memoryRecords                MemoryRecord[]
  kgEntities                   KgEntity[]
  kgRelationships              KgRelationship[]
  taxonomyTerms                TaxonomyTerm[]
  taxonomyAssignments          TaxonomyAssignment[]
  gpuAllocations               GpuAllocation[]
  modelServingDeployments      ModelServingDeployment[]
  aiRouterPolicies             AiRouterPolicy[]
  aiRouterDecisions            AiRouterDecision[]
  streamingSessions            StreamingSession[]
  batchRuns                    BatchRun[]
  cacheEntries                 CacheEntry[]
  costBudgets                  CostBudget[]
  costSpendEvents              CostSpendEvent[]

  @@map("organizations")
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique @map("clerk_user_id")
  email       String?
  name        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  apiKeys     ApiKey[]
  auditEvents AuditEvent[]
  reviews     TranslationReview[]

  @@map("users")
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  userId         String         @map("user_id")
  role           MembershipRole @default(member)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("memberships")
}

model Workspace {
  id                 String   @id @default(cuid())
  organizationId     String   @map("organization_id")
  name               String
  defaultSourceLang  String   @default("en") @map("default_source_lang")
  defaultTargetLang  String   @default("sw") @map("default_target_lang")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys             ApiKey[]
  translationRequests TranslationRequest[]
  usageEvents         UsageEvent[]
  jobs                Job[]
  documents           Document[]
  glossaryTerms       GlossaryTerm[]
  tmEntries           TranslationMemoryEntry[]
  translationReviews  TranslationReview[]
  knowledgeDocuments  KnowledgeDocument[]
  knowledgeChunks     KnowledgeChunk[]
  slackInstallations  SlackInstallation[]
  workflows           Workflow[]
  prompts             Prompt[]
  marketplaceListings MarketplaceListing[] @relation("MarketplacePublisherWorkspace")
  marketplaceInstalls MarketplaceInstall[] @relation("MarketplaceInstallerWorkspace")
  datasetAssets       DatasetAsset[]
  verticalGlossaryInstalls VerticalGlossaryInstall[]
  voiceClones         VoiceClone[]
  speechVocabularyTerms SpeechVocabularyTerm[]
  speakerProfiles     SpeakerProfile[]
  speakerEvents       SpeakerEvent[]
  wakeKeywords        WakeKeyword[]
  callRecords         CallRecord[]
  voiceStudioProjects VoiceStudioProject[]
  voiceStudioLexemes  VoiceStudioLexeme[]
  voiceStudioProfiles VoiceStudioProfile[]
  voiceListingsPublished VoiceListing[] @relation("VoiceListingPublisherWorkspace")
  voiceListingInstalls   VoiceListingInstall[] @relation("VoiceListingInstallerWorkspace")
  memoryRecords          MemoryRecord[]
  kgEntities             KgEntity[]
  kgRelationships        KgRelationship[]
  taxonomyTerms          TaxonomyTerm[]
  taxonomyAssignments    TaxonomyAssignment[]
  gpuAllocations         GpuAllocation[]
  modelServingDeployments ModelServingDeployment[]
  aiRouterPolicies       AiRouterPolicy[]
  aiRouterDecisions      AiRouterDecision[]
  streamingSessions      StreamingSession[]
  batchRuns              BatchRun[]
  cacheEntries           CacheEntry[]
  costBudgets            CostBudget[]
  costSpendEvents        CostSpendEvent[]

  @@index([organizationId])
  @@map("workspaces")
}

model Job {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  workspaceId    String    @map("workspace_id")
  apiKeyId       String?   @map("api_key_id")
  type           String
  status         String    @default("queued")
  input          Json
  result         Json?
  error          String?
  webhookUrl     String?   @map("webhook_url")
  webhookStatus  String?   @map("webhook_status")
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKey       ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([status])
  @@map("jobs")
}

model Document {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  apiKeyId       String?  @map("api_key_id")
  kind           String   @default("source") // source | output
  filename       String
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  storageKey     String   @map("storage_key")
  sourceLang     String?  @map("source_lang")
  targetLang     String?  @map("target_lang")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKey       ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("documents")
}

model GlossaryTerm {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  sourceLang     String   @map("source_lang")
  targetLang     String   @map("target_lang")
  sourceTerm     String   @map("source_term")
  targetTerm     String   @map("target_term")
  caseSensitive  Boolean  @default(false) @map("case_sensitive")
  wholeWord      Boolean  @default(true) @map("whole_word")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceLang, targetLang, sourceTerm])
  @@index([workspaceId, sourceLang, targetLang])
  @@map("glossary_terms")
}

model TranslationMemoryEntry {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  /// workspace | enterprise | shared | project
  scope          String   @default("workspace")
  /// Project key when scope=project; empty string otherwise.
  projectKey     String   @default("") @map("project_key")
  sourceLang     String   @map("source_lang")
  targetLang     String   @map("target_lang")
  sourceText     String   @map("source_text")
  targetText     String   @map("target_text")
  sourceHash     String   @map("source_hash")
  approved       Boolean  @default(true)
  hitCount       Int      @default(0) @map("hit_count")
  version        Int      @default(1)
  /// OpenAI text-embedding-3-small (1536-d). Written/read via raw SQL when present.
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions     TranslationMemoryVersion[]

  @@unique([workspaceId, sourceLang, targetLang, sourceHash], map: "tm_entries_ws_langs_hash_key")
  @@index([workspaceId, sourceLang, targetLang], map: "tm_entries_ws_langs_idx")
  @@index([organizationId, scope, sourceLang, targetLang], map: "tm_entries_org_scope_langs_idx")
  @@index([organizationId, projectKey, sourceLang, targetLang], map: "tm_entries_org_project_langs_idx")
  @@map("translation_memory_entries")
}

model TranslationMemoryVersion {
  id        String   @id @default(cuid())
  entryId   String   @map("entry_id")
  version   Int
  sourceText String  @map("source_text")
  targetText String  @map("target_text")
  scope     String
  projectKey String  @default("") @map("project_key")
  createdById String? @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  entry TranslationMemoryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, version], map: "tm_versions_entry_version_key")
  @@index([entryId], map: "tm_versions_entry_idx")
  @@map("translation_memory_versions")
}

model TranslationReview {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  workspaceId    String    @map("workspace_id")
  sourceLang     String    @map("source_lang")
  targetLang     String    @map("target_lang")
  sourceText     String    @map("source_text")
  targetText     String    @map("target_text")
  provider       String
  qualityScore   Int       @map("quality_score")
  needsReview    Boolean   @default(false) @map("needs_review")
  status         String    @default("pending") // pending | accepted | rejected
  reviewNote     String?   @map("review_note")
  reviewedById   String?   @map("reviewed_by_id")
  reviewedAt     DateTime? @map("reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt], map: "tr_reviews_org_status_idx")
  @@map("translation_reviews")
}

model ApiKey {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  workspaceId    String             @map("workspace_id")
  createdById    String?            @map("created_by_id")
  name           String
  prefix         String
  secretHash     String             @map("secret_hash")
  environment    ApiKeyEnvironment  @default(live)
  revokedAt      DateTime?          @map("revoked_at")
  lastUsedAt     DateTime?          @map("last_used_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy           User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  translationRequests TranslationRequest[]
  usageEvents         UsageEvent[]
  jobs                Job[]
  documents           Document[]
  knowledgeDocuments  KnowledgeDocument[]

  @@index([prefix])
  @@index([organizationId])
  @@map("api_keys")
}

enum LinguisticRuleKind {
  pronunciation
  grammar
  phonetic
  morphology
}

enum WritingSystemKind {
  alphabet
  abjad
  abugida
  syllabary
  logographic
  other
}

/** Language family node (VL-139). Curated — not Ethnologue parity. */
model LanguageFamily {
  id        String   @id @default(cuid())
  code      String   @unique
  nameEn    String   @map("name_en")
  parentCode String? @map("parent_code")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  languages Language[]

  @@map("language_families")
}

/**
 * Writing system / script / alphabet registry (ISO 15924) — VL-139.
 * "Alphabet" rows use kind=alphabet; all kinds are writing systems.
 */
model WritingSystem {
  id          String            @id @default(cuid())
  /// ISO 15924 four-letter code
  code        String            @unique
  nameEn      String            @map("name_en")
  kind        WritingSystemKind @default(alphabet)
  rtl         Boolean           @default(false)
  sampleChars String?           @map("sample_chars")
  notes       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([kind])
  @@map("writing_systems")
}

/**
 * Curated linguistic rule catalog (VL-139). Metadata for validation/docs —
 * not a runtime morphology/phonetics engine.
 */
model LinguisticRule {
  id           String             @id @default(cuid())
  code         String             @unique
  kind         LinguisticRuleKind
  languageCode String?            @map("language_code")
  nameEn       String             @map("name_en")
  description  String
  /// optional pattern / cue string for clients
  pattern      String?
  /// string[] examples
  examples     Json               @default("[]")
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  language Language? @relation(fields: [languageCode], references: [code], onDelete: SetNull)

  @@index([kind])
  @@index([languageCode])
  @@map("linguistic_rules")
}

model Language {
  id         String        @id @default(cuid())
  code       String        @unique
  nameEn     String        @map("name_en")
  nameNative String?       @map("name_native")
  script     String?
  familyCode String?       @map("family_code")
  rtl        Boolean       @default(false)
  tier       LanguageTier  @default(vendor)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  family     LanguageFamily? @relation(fields: [familyCode], references: [code], onDelete: SetNull)
  localePack LocalePack?
  dialects   Dialect[]
  accents    Accent[]
  linguisticRules LinguisticRule[]

  @@index([familyCode])
  @@map("languages")
}

/** Curated dialect labels for a registry language (VL-131). Not unlimited coverage. */
model Dialect {
  id           String   @id @default(cuid())
  code         String   @unique
  languageCode String   @map("language_code")
  nameEn       String   @map("name_en")
  nameNative   String?  @map("name_native")
  region       String?
  /// string[] orthographic / lexical cues used for heuristic scoring
  cueTerms     Json     @default("[]") @map("cue_terms")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  language Language @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@index([languageCode])
  @@map("dialects")
}

/** Spoken accent profiles (VL-132). Transcript-assisted — not acoustic phonetics ID. */
model Accent {
  id                 String   @id @default(cuid())
  code               String   @unique
  languageCode       String   @map("language_code")
  nameEn             String   @map("name_en")
  nameNative         String?  @map("name_native")
  region             String?
  relatedDialectCode String?  @map("related_dialect_code")
  /// string[] lexical / orthographic proxies used after STT or on text
  cueTerms           Json     @default("[]") @map("cue_terms")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  language Language @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@index([languageCode])
  @@map("accents")
}

/** Cultural / locale notes for a registry language (VL-102). Not a culture platform. */
model LocalePack {
  id             String   @id @default(cuid())
  languageCode   String   @unique @map("language_code")
  /// BCP-47 tag for Intl, e.g. sw-TZ
  bcp47          String?
  dateNotes      String?  @map("date_notes")
  numberNotes    String?  @map("number_notes")
  currencyCode   String?  @map("currency_code")
  currencyNotes  String?  @map("currency_notes")
  /// [{ form, usage, notes }]
  honorifics     Json?
  /// string[] entities that should not be MT-mutated
  doNotTranslate Json?    @map("do_not_translate")
  culturalNotes  String?  @map("cultural_notes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  language Language @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@map("locale_packs")
}

/** Country / regional localization guidance (VL-135). Composes language locale packs. */
model CountryPack {
  id                   String   @id @default(cuid())
  /// ISO 3166-1 alpha-2
  code                 String   @unique
  nameEn               String   @map("name_en")
  region               String?
  currencyCode         String?  @map("currency_code")
  /// string[] language registry codes
  primaryLanguages     Json     @default("[]") @map("primary_languages")
  /// string[] BCP-47 tags e.g. sw-KE
  bcp47Tags            Json     @default("[]") @map("bcp47_tags")
  relatedDialectCodes  Json     @default("[]") @map("related_dialect_codes")
  relatedAccentCodes   Json     @default("[]") @map("related_accent_codes")
  dateNotes            String?  @map("date_notes")
  numberNotes          String?  @map("number_notes")
  currencyNotes        String?  @map("currency_notes")
  culturalNotes        String?  @map("cultural_notes")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([region])
  @@map("country_packs")
}

model TranslationRequest {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  apiKeyId       String?  @map("api_key_id")
  sourceLang     String   @map("source_lang")
  targetLang     String   @map("target_lang")
  characters     Int
  provider       String
  latencyMs      Int?     @map("latency_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKey       ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("translation_requests")
}

model UsageEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  apiKeyId       String?  @map("api_key_id")
  feature        String
  unitType       String   @map("unit_type")
  units          Int
  provider       String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKey       ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("usage_events")
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  route          String?
  ip             String?
  apiKeyPrefix   String?  @map("api_key_prefix")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

/// Workspace knowledge corpus document (RAG). Separate from translation Document (VL-040).
model KnowledgeDocument {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  apiKeyId       String?  @map("api_key_id")
  filename       String
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  storageKey     String   @map("storage_key")
  status         String   @default("processing") // processing | ready | failed
  error          String?
  chunkCount     Int      @default(0) @map("chunk_count")
  /// VL-194 EKB: logical collection within a workspace (not a vector OS).
  collection     String   @default("default")
  /// VL-194 EKB: freeform tags for filtering (not taxonomy OS).
  tags           String[] @default([])
  /// VL-194 EKB: document | policy | manual | book | markdown | html | …
  contentKind    String   @default("document") @map("content_kind")
  /// VL-194 EKB: light revise counter (not full history table).
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKey       ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  chunks       KnowledgeChunk[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, collection])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String                       @id @default(cuid())
  organizationId String                       @map("organization_id")
  workspaceId    String                       @map("workspace_id")
  documentId     String                       @map("document_id")
  ordinal        Int
  content        String
  /// OpenAI text-embedding-3-small (1536-d). Written/read via raw SQL.
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([documentId, ordinal])
  @@map("knowledge_chunks")
}

model SlackInstallation {
  id                String   @id @default(cuid())
  teamId            String   @unique @map("team_id")
  teamName          String?  @map("team_name")
  organizationId    String   @map("organization_id")
