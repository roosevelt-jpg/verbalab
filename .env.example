# Shared (copy to `.env` / `apps/api/.env` / `apps/web/.env.local`)

# Postgres (Compose maps host 5433 → container 5432)
DATABASE_URL="postgresql://lugemi:lugemi@localhost:5433/lugemi?schema=public"

# API
API_PORT=3001
# Comma-separated. Nest mirrors localhost↔127.0.0.1 twins and always allows Studio :43123–43130 + :3000.
CORS_ORIGIN=http://127.0.0.1:43125,http://localhost:43125,http://127.0.0.1:43126,http://localhost:43126,http://localhost:3000
# Production CORS (comma-separated). Nest also always allows lugemi.com / www / api.
# CORS_ORIGIN=https://lugemi.com,https://www.lugemi.com
# Browser → API (web). Use 127.0.0.1 to match Studio on :43125. Production: https://api.lugemi.com (Fly app name may still be verbalab-api)
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Public web origin (emails, billing redirects). Production: https://lugemi.com
# APP_URL=https://lugemi.com
# APP_PUBLIC_URL=https://lugemi.com
# NEXT_PUBLIC_APP_URL=https://lugemi.com
# Vercel project: Root Directory = apps/web (see vercel.json). Do not deploy apps/api to Vercel.

# Observability (VL-070) — optional; no-op when unset
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# TRANSLATE_LATENCY_SAMPLES=1000

# Clerk (Phase 1) — required for console sign-in / session routes
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# After Clerk auth, resolve admin vs onboarding at /post-auth (no wizard flash for platform admins).
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/post-auth
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/post-auth
# Local only: allow /api/dev-login ticket mint with sk_live_ (never in production)
# ALLOW_CLERK_DEV_LOGIN=true
# Live keys need https://local.lugemi.com (hosts → 127.0.0.1; HTTPS :443 → Next :43125).
#   sudo node apps/web/scripts/local-lugemi-https-proxy.mjs
# Local/dev: after Clerk sign-in/up, skip /onboarding and land in Creative
# NEXT_PUBLIC_SKIP_ONBOARDING=1

# Lugemi proprietary model endpoints (optional). Unset = in-repo local engines (Baobab/Atlas/Echo/Vector).
# LUGEMI_MT_URL=
# LUGEMI_CHAT_URL=
# LUGEMI_ASR_URL=
# LUGEMI_EMBED_URL=
# LUGEMI_OCR_URL=

# Lugemi first-party speech (Echo Voice) — own:* voices. Local engine ready without URL.
# OWN_TTS_URL=https://your-lugemi-tts.example/v1/tts
# OWN_TTS_API_KEY=
# OWN_TTS_FIXTURE=0  # optional: force unconfigured refuse; default local Echo Voice is on

# --- Legacy / internal adapters (not the public product; optional local fallbacks) ---

# Legacy translate / detect adapter. Tests use fixtures without it.
GOOGLE_TRANSLATE_API_KEY=
# EVAL_LIVE=1  # VL-100: allow POST /v1/eval/run?mode=live (incurs MT cost)
# Offline franc-min fallback when unset.

# Clerk Google OAuth — show "Continue with Google" on /sign-up and /sign-in.
# Requires Google Social Connection enabled in Clerk Dashboard (+ GCP OAuth client).
# Production Fly builds default to true; set false to hide the button.
NEXT_PUBLIC_CLERK_GOOGLE_OAUTH_ENABLED=true

# Legacy OCR adapter — optional separate key; falls back to GOOGLE_TRANSLATE_API_KEY
# GOOGLE_VISION_API_KEY=
# OCR_MAX_BYTES=8388608
# OCR_TIMEOUT_MS=60000

# Legacy STT / stock TTS / chat / embeddings adapter. Tests use fixtures.
OPENAI_API_KEY=
# Optional chat fallback (OpenAI-compatible) — VL-129
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_TTS_MODEL=tts-1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
# RAG_CHUNK_SIZE=700
# RAG_CHUNK_OVERLAP=80
# RAG_TOP_K=5
# KNOWLEDGE_MAX_DOCS=20
# AUDIO_MAX_BYTES=10485760
# STT_TIMEOUT_MS=120000
# TTS_TIMEOUT_MS=60000
# TTS_MAX_CHARS=4096

# Legacy voice-clone adapter. Tests use fixtures.
# VENDOR_VOICE_CLONE_API_KEY=
# VENDOR_VOICE_CLONE_API_BASE=
# Legacy alias still accepted: ELEVENLABS_API_KEY=

# Residency island (VL-075) — us (default) | eu | af; must match the Fly app for that region
# LUGEMI_REGION=us
# Optional public URLs stamped in GET /v1/regions (AF defaults = brand domain)
# LUGEMI_API_URL_AF=https://api.lugemi.com
# LUGEMI_WEB_URL_AF=https://lugemi.com
# LUGEMI_API_URL_US=https://lugemi-api.fly.dev
# LUGEMI_API_URL_EU=https://lugemi-api-eu.fly.dev
# LUGEMI_WEB_URL_US=https://lugemi-web.fly.dev
# LUGEMI_WEB_URL_EU=https://lugemi-web-eu.fly.dev

# Quality reviews (VL-052) — heuristic needsReview threshold (0-100)
# QUALITY_REVIEW_THRESHOLD=70

# Localization files (VL-053)
# LOCALIZE_MAX_STRINGS=200
# LOCALIZE_MAX_BYTES=524288

# Stripe billing (VL-031) — required for checkout/portal; quota enforcement works without it
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=
BILLING_SUCCESS_URL=http://localhost:3000/billing?checkout=success
BILLING_CANCEL_URL=http://localhost:3000/billing?checkout=cancel
BILLING_PORTAL_RETURN_URL=http://localhost:3000/billing
# Production billing redirects: https://lugemi.com/billing?...
# Marketplace Connect (VL-092) — falls back to BILLING_* URLs when unset
# STRIPE_CONNECT_RETURN_URL=http://localhost:3000/marketplace?connect=return
# STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/marketplace?connect=refresh
# MARKETPLACE_CHECKOUT_SUCCESS_URL=http://localhost:3000/marketplace?checkout=success
# MARKETPLACE_CHECKOUT_CANCEL_URL=http://localhost:3000/marketplace?checkout=cancel
# MARKETPLACE_PLATFORM_FEE_BPS=2000
# Optional quota overrides (plans: free / pro / business / enterprise)
# BILLING_FREE_CHARACTER_QUOTA=50000
# BILLING_PRO_CHARACTER_QUOTA=2000000
# BILLING_BUSINESS_CHARACTER_QUOTA=11000000
# BILLING_ENTERPRISE_CHARACTER_QUOTA=50000000

# Redis / jobs (VL-044) — Compose maps host 6379
REDIS_URL=redis://127.0.0.1:6379
# Set JOBS_INLINE=1 to process jobs in-process (tests do this automatically)
# JOBS_INLINE=1

# Rate limits (VL-071) — per window (RATE_LIMIT_WINDOW_SEC, default 60s)
# RATE_LIMIT_FREE_PER_KEY=60
# RATE_LIMIT_FREE_PER_ORG=120
# RATE_LIMIT_PRO_PER_KEY=300
# RATE_LIMIT_PRO_PER_ORG=1000
# RATE_LIMIT_BUSINESS_PER_KEY=600
# RATE_LIMIT_BUSINESS_PER_ORG=3000
# RATE_LIMIT_ENTERPRISE_PER_KEY=2000
# RATE_LIMIT_ENTERPRISE_PER_ORG=10000
# RATE_LIMIT_MEMORY=1
# RATE_LIMIT_DISABLED=1

# Document translation (VL-040)
# DOCUMENT_MAX_BYTES=5242880
# DOCUMENT_STORAGE_DIR=./apps/api/storage
# DATASET_MAX_BYTES=52428800

# Optional: set TRANSLATE_LIVE=1 to run the live Google adapter test
# TRANSLATE_LIVE=1

# Playwright signed-in translate (optional)
# E2E_CLERK_USER_EMAIL=
# E2E_CLERK_USER_PASSWORD=
# On Windows, Playwright uses system Chrome by default (PLAYWRIGHT_CHANNEL=chrome)

# Production (VL-074) — see infra/DEPLOY.md (Fly.io). Do not set JOBS_INLINE in prod.
# FLY_API_TOKEN is a GitHub Actions secret for .github/workflows/deploy.yml

# Email / notifications (VL-080) — optional; no-op when unset
# RESEND_API_KEY=              # Fly: fly secrets set RESEND_API_KEY='re_...' -a lugemi-api
#                              # Also set on verbalab / lugemi if those API apps still exist.
# EMAIL_FROM=Lugemi <noreply@lugemi.com>
# NOTIFICATIONS_DISABLED=1
# Domain must be verified in Resend (DKIM + SPF). See docs/fly.md § Resend email.
# Inbound mail: Cloudflare Email Routing (free) can forward support@ → inbox; keep Resend for outbound.

# Cloudflare free integrations (optional) — see docs/cloudflare.md
# CF_ZONE_ID=
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_PUBLIC_BASE_URL=
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
# CF_AI_ACCOUNT_ID=
# CF_AI_API_TOKEN=

# Platform admin — comma-separated allowlists for /admin and /admin/workspaces
# ADMIN_EMAILS=you@company.com
# LUGEMI_PLATFORM_ADMIN_EMAILS=you@company.com
# ADMIN_USER_IDS=user_clerk_xxx
# LUGEMI_PLATFORM_ADMIN_USER_IDS=user_clerk_xxx

# Slack connector (VL-082) — CI uses signed fixtures; live needs signing secret
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_CONNECTOR_DISABLED=1

# Voice agents / Twilio FAQ (VL-084) — CI uses simulate + signature fixtures; live needs Twilio + OPENAI_API_KEY
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WEBHOOK_BASE_URL=https://your-api.example
# VOICE_DEMO_ORG_ID=
# VOICE_DEMO_WORKSPACE_ID=
# VOICE_FAQ_VOICE=alloy
# VOICE_AGENT_DISABLED=1

# Analytics estimated costs (VL-085) — USD per unit; not Stripe invoices
# ANALYTICS_COST_TRANSLATE_PER_1K_CHARS=0.02
# ANALYTICS_COST_STT_PER_MINUTE=0.006
# ANALYTICS_COST_TTS_PER_1K_CHARS=0.015
# ANALYTICS_COST_OCR_PER_PAGE=0.002
# ANALYTICS_COST_CHAT_PER_1K_TOKENS=0.00015
# ANALYTICS_COST_EMBEDDINGS_PER_1K_TOKENS=0.00002
