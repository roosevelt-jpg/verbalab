{
  "name": "lugemi",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "audit": "pnpm audit --prod --audit-level=high",
    "db:generate": "pnpm --filter @lugemi/api exec prisma generate",
    "db:migrate": "pnpm --filter @lugemi/api exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @lugemi/api exec prisma migrate dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "smoke": "node scripts/smoke-deploy.mjs",
    "test:e2e": "pnpm --filter @lugemi/web test:e2e"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr@<2.0.8": "^2.0.8",
      "lodash@<4.18.0": "^4.18.0",
      "multer@<2.3.0": "^2.3.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "postcss@<8.5.18": "^8.5.18",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@<1.2.2": "^1.2.2",
      "brace-expansion@>=4.0.0 <5.0.11": "^5.0.11",
      "@graphql-tools/utils@<12.0.1": "^12.0.1",
      "deepmerge-ts@<8.0.0": "^8.0.0"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-93687"
      ]
    }
  }
}
