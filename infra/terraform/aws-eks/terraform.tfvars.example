# Copy to terraform.tfvars (do not commit secrets).
aws_region           = "af-south-1"
cluster_name         = "verbalab"
kubernetes_version   = "1.31"
node_instance_types  = ["t3.medium"]
node_desired_size    = 2
node_min_size        = 1
node_max_size        = 4
vpc_cidr             = "10.40.0.0/16"
