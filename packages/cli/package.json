{
  "name": "@verbalab/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Thin CLI for the VerbaLab API (wraps @verbalab/sdk)",
  "type": "module",
  "bin": {
    "verbalab": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@verbalab/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@verbalab/eslint-config": "workspace:*",
    "@verbalab/typescript-config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
