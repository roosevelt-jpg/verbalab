model MemoryRecord {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  workspaceId    String    @map("workspace_id")
  subjectUserId  String?   @map("subject_user_id")
  agentId        String?   @map("agent_id")
  projectKey     String?   @map("project_key")
  conversationId String?   @map("conversation_id")
  scope          String
  kind           String
  key            String?
  content        String
  metadata       Json      @default("{}")
  version        Int       @default(1)
  expiresAt      DateTime? @map("expires_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, createdAt])
  @@index([organizationId, subjectUserId])
  @@index([workspaceId, scope, kind])
  @@index([conversationId])
  @@index([workspaceId, key])
  @@map("memory_records")
}

/// Bounded knowledge-graph entity (VL-184). Not Neo4j / ontology platform.
model KgEntity {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  type           String   @default("concept")
  name           String
  description    String   @default("")
  documentId     String?  @map("document_id")
  domain         String   @default("general")
  aliases        String[] @default([])
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outgoing     KgRelationship[] @relation("KgRelFrom")
  incoming     KgRelationship[] @relation("KgRelTo")

  @@index([organizationId, workspaceId, name])
  @@index([workspaceId, type])
  @@index([workspaceId, domain])
  @@index([documentId])
  @@map("kg_entities")
}

/// Bounded knowledge-graph edge (VL-184).
model KgRelationship {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  fromEntityId   String   @map("from_entity_id")
  toEntityId     String   @map("to_entity_id")
  type           String   @default("related_to")
  label          String   @default("")
  weight         Float    @default(1)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromEntity   KgEntity     @relation("KgRelFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity     KgEntity     @relation("KgRelTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([workspaceId, type])
  @@map("kg_relationships")
}

/// Taxonomy term / tree node (VL-197). Classification trees — not enterprise taxonomy OS.
model TaxonomyTerm {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  parentId       String?  @map("parent_id")
  slug           String
  name           String
  /// category | tag | content_type
  kind           String   @default("category")
  description    String   @default("")
  sortOrder      Int      @default(0) @map("sort_order")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent       TaxonomyTerm?        @relation("TaxonomyTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     TaxonomyTerm[]       @relation("TaxonomyTree")
  assignments  TaxonomyAssignment[]

  @@unique([workspaceId, slug])
  @@index([organizationId, workspaceId, kind])
  @@index([workspaceId, parentId])
  @@map("taxonomy_terms")
}

/// Document ↔ taxonomy term assignment (VL-197). Always org+workspace scoped.
model TaxonomyAssignment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  termId         String   @map("term_id")
  documentId     String   @map("document_id")
  /// manual | heuristic
  source         String   @default("manual")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  term         TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([termId, documentId])
  @@index([organizationId, workspaceId])
  @@index([documentId])
  @@map("taxonomy_assignments")
}

/// Sandbox GPU allocation record (VL-205). Logical inventory only — never calls a cloud GPU API.
model GpuAllocation {
  id                 String    @id @default(cuid())
  organizationId     String    @map("organization_id")
  workspaceId        String    @map("workspace_id")
  /// nvidia | amd | intel
  vendor             String
  poolId             String    @map("pool_id")
  instances          Int       @default(1)
  estimatedHourlyUsd Float     @map("estimated_hourly_usd")
  /// pending | active | released | rejected
  status             String    @default("pending")
  purpose            String    @default("")
  reservationUntil   DateTime? @map("reservation_until")
  metadata           Json      @default("{}")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, status])
  @@index([workspaceId, vendor])
  @@map("gpu_allocations")
}

/// Sandbox model-serving deployment (VL-206). Logical record only — traffic still via AI Gateway.
model ModelServingDeployment {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  workspaceId      String   @map("workspace_id")
  /// llm | speech | voice | ocr | embedding | vision | reasoning
  kind             String
  modelSlug        String   @map("model_slug")
  modelId          String   @map("model_id")
  version          String   @default("v1")
  /// rolling | canary | blue_green
  strategy         String   @default("rolling")
  trafficPercent   Int      @default(100) @map("traffic_percent")
  /// none | blue | green
  slot             String   @default("none")
  /// pending | active | canary | blue | green | standby | released
  status           String   @default("pending")
  label            String   @default("")
  previousVersion  String?  @map("previous_version")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, status])
  @@index([workspaceId, kind, modelSlug])
  @@map("model_serving_deployments")
}

/// Workspace AI Router policy (VL-207). Advisory — Gateway still executes inference.
model AiRouterPolicy {
  id                    String   @id @default(cuid())
  organizationId        String   @map("organization_id")
  workspaceId           String   @map("workspace_id")
  /// latency | cost | balanced | quality
  optimize              String   @default("balanced")
  maxRetries            Int      @default(1) @map("max_retries")
  preferRegion          String   @default("af-south-1") @map("prefer_region")
  allowFallback         Boolean  @default(true) @map("allow_fallback")
  preferConfiguredOnly  Boolean  @default(true) @map("prefer_configured_only")
  streamingPreferred    Boolean  @default(false) @map("streaming_preferred")
  preferProvider        String   @default("") @map("prefer_provider")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, workspaceId])
  @@map("ai_router_policies")
}

/// Dry-run AI Router decision log (VL-207).
model AiRouterDecision {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  workspaceId      String   @map("workspace_id")
  feature          String
  optimize         String
  selectedProvider String   @map("selected_provider")
  selectedModel    String   @map("selected_model")
  chainJson        Json     @default("[]") @map("chain_json")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, createdAt])
  @@index([workspaceId, feature])
  @@map("ai_router_decisions")
}

/// Sandbox streaming session (VL-208). Tracks SSE chunk streams — not a WebSocket OS.
model StreamingSession {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  /// speech | voice | translation | llm | video | realtime
  kind           String
  /// sse | websocket | grpc
  transport      String   @default("sse")
  /// open | streaming | closed | failed
  status         String   @default("open")
  label          String   @default("")
  chunkCount     Int      @default(0) @map("chunk_count")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, status])
  @@index([workspaceId, kind])
  @@map("streaming_sessions")
}

/// Batch Runtime run (VL-209). Translation may delegate to Job; other kinds are sandbox.
model BatchRun {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  workspaceId      String    @map("workspace_id")
  /// translation | speech | ocr | embedding | training | video
  kind             String
  /// low | normal | high
  priority         String    @default("normal")
  priorityWeight   Int       @default(15) @map("priority_weight")
  /// queued | scheduled | running | completed | failed
  status           String    @default("queued")
  label            String    @default("")
  itemCount        Int       @default(0) @map("item_count")
  checkpointIndex  Int       @default(0) @map("checkpoint_index")
  attempts         Int       @default(0)
  maxRetries       Int       @default(2) @map("max_retries")
  jobId            String?   @map("job_id")
  runAt            DateTime? @map("run_at")
  error            String?
  result           Json      @default("{}")
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, status])
  @@index([workspaceId, kind, priorityWeight])
  @@map("batch_runs")
}

/// Intelligent Cache entry (VL-210). Exact-key / normalized-hash sandbox store — not Redis Cluster OS.
model CacheEntry {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  workspaceId    String    @map("workspace_id")
  /// semantic | translation | embedding | speech | voice | document | prompt | context
  namespace       String
  cacheKey       String    @map("cache_key")
  valueJson      Json      @map("value_json")
  hits           Int       @default(0)
  misses         Int       @default(0)
  expiresAt      DateTime? @map("expires_at")
  labels         String[]  @default([])
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, workspaceId, namespace, cacheKey])
  @@index([organizationId, workspaceId, namespace])
  @@index([expiresAt])
  @@map("cache_entries")
}

/// Cost Optimization budget (VL-211). Hard daily/monthly spend caps — not report-only FinOps OS.
model CostBudget {
  id                   String   @id @default(cuid())
  organizationId       String   @map("organization_id")
  workspaceId          String   @map("workspace_id")
  dailyCapUsd          Float    @map("daily_cap_usd")
  monthlyCapUsd        Float    @map("monthly_cap_usd")
  enforce              Boolean  @default(true)
  preferSpot           Boolean  @default(true) @map("prefer_spot")
  reservedCapacityUnits Int     @default(0) @map("reserved_capacity_units")
  optimizeRouting      Boolean  @default(true) @map("optimize_routing")
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([organizationId, workspaceId])
  @@map("cost_budgets")
}

/// Cost Optimization spend ledger event (VL-211). Sandbox recorded spend for enforcement.
model CostSpendEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  workspaceId    String   @map("workspace_id")
  /// provider | gpu | router | batch | cache | other
  category       String
  amountUsd      Float    @map("amount_usd")
  feature        String   @default("")
  providerId     String   @default("") @map("provider_id")
  label          String   @default("")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([organizationId, workspaceId, createdAt])
  @@index([workspaceId, category])
  @@map("cost_spend_events")
}


